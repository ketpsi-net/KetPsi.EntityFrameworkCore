<Project Sdk="Microsoft.NET.Sdk">

  <!-- The shared queries without the generator: they run on EF Core's own query pipeline. -->
  <PropertyGroup>
    <Description>The differential query catalog compiled without KetPsi, so every query runs through stock EF Core.</Description>
    <TargetFrameworks>$(KetPsiTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\KetPsi.EntityFrameworkCore.Differential.Queries\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KetPsi.EntityFrameworkCore.Differential.Model\KetPsi.EntityFrameworkCore.Differential.Model.csproj" />
  </ItemGroup>

</Project>
