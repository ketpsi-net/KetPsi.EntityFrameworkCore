<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);RSEXPERIMENTAL002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- Referenced so test snippets compile against real EF Core and SQL Server provider assemblies. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KetPsi.EntityFrameworkCore.Generator\KetPsi.EntityFrameworkCore.Generator.csproj" />
    <ProjectReference Include="..\..\src\KetPsi.EntityFrameworkCore\KetPsi.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\KetPsi.EntityFrameworkCore.SqlServer\KetPsi.EntityFrameworkCore.SqlServer.csproj" />
    <ProjectReference Include="..\KetPsi.EntityFrameworkCore.TestUtilities\KetPsi.EntityFrameworkCore.TestUtilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Snapshots are expected generator output, not part of the test assembly. -->
    <Compile Remove="**\*.verified.cs" />
    <None Include="**\*.verified.cs" />
  </ItemGroup>

</Project>
