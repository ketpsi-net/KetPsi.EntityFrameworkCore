<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\version.props" />

  <PropertyGroup>
    <TargetFrameworks>$(KetPsiTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Plain EF Core LINQ that runs under Native AOT. A source generator translates each query to parameterized SQL at build time and intercepts the call; at runtime it runs on the DbContext's own connection and transaction with generated readers, without runtime query translation or compilation. Supports filtering, ordering, paging, terminals, query filters, tracking and Include/ThenInclude, with EF Core's semantics. Anything it cannot translate is a build error. Ships the runtime, the generator and the MSBuild settings that enable its interceptors.</Description>
    <PackageTags>entityframeworkcore;efcore;ef;nativeaot;aot;trimming;source-generator;interceptors;linq;sql;ketpsi</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KetPsi.EntityFrameworkCore.Tests" />
    <!-- Generator tests run generated interceptors and inspect the operator chain and SQL they produce. -->
    <InternalsVisibleTo Include="KetPsi.EntityFrameworkCore.Generator.Tests" />
  </ItemGroup>

  <!--
    The source generator ships inside this package (analyzers/dotnet/cs). The project reference only builds the
    generator first; it is not referenced as an assembly and does not run on this library.
  -->
  <ItemGroup>
    <ProjectReference Include="..\KetPsi.EntityFrameworkCore.Generator\KetPsi.EntityFrameworkCore.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <PropertyGroup>
    <KetPsiGeneratorDirectory>$(MSBuildThisFileDirectory)..\KetPsi.EntityFrameworkCore.Generator\</KetPsiGeneratorDirectory>
    <KetPsiGeneratorDll>$(KetPsiGeneratorDirectory)bin\$(Configuration)\netstandard2.0\KetPsi.EntityFrameworkCore.Generator.dll</KetPsiGeneratorDll>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(KetPsiGeneratorDll)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- Named after the package so NuGet imports them. buildTransitive also reaches apps that only reference
         KetPsi.EntityFrameworkCore.SqlServer, which depends on this package. -->
    <None Include="$(KetPsiGeneratorDirectory)build\KetPsi.EntityFrameworkCore.Generator.props" Pack="true" PackagePath="build\$(PackageId).props" Visible="false" />
    <None Include="$(KetPsiGeneratorDirectory)build\KetPsi.EntityFrameworkCore.Generator.targets" Pack="true" PackagePath="build\$(PackageId).targets" Visible="false" />
    <None Include="$(KetPsiGeneratorDirectory)build\KetPsi.EntityFrameworkCore.Generator.props" Pack="true" PackagePath="buildTransitive\$(PackageId).props" Visible="false" />
    <None Include="$(KetPsiGeneratorDirectory)build\KetPsi.EntityFrameworkCore.Generator.targets" Pack="true" PackagePath="buildTransitive\$(PackageId).targets" Visible="false" />
  </ItemGroup>

  <!-- Never ship a package without the generator. -->
  <Target Name="KetPsiEnsureGeneratorPacked" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <Error Condition="!Exists('$(KetPsiGeneratorDll)')"
           Text="KetPsi.EntityFrameworkCore.Generator.dll was not found at '$(KetPsiGeneratorDll)'. Build the generator (Configuration=$(Configuration)) before packing." />
  </Target>

</Project>
