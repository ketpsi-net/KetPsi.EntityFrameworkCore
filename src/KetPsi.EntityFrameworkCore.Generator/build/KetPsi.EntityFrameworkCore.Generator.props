<Project>
  <!-- Lets the compiler accept the generated interceptors, and lets the generator check that it does. -->
  <PropertyGroup>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);KetPsi.EntityFrameworkCore.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="InterceptorsNamespaces" />
    <CompilerVisibleProperty Include="InterceptorsPreviewNamespaces" />
  </ItemGroup>
</Project>
