<Project>
  <!-- Lets the compiler accept the generated interceptors. -->
  <PropertyGroup>
    <InterceptorsNamespaces Condition="'$(InterceptorsNamespaces)' == ''">KetPsi.EntityFrameworkCore.Generated</InterceptorsNamespaces>
    <InterceptorsNamespaces Condition="!$(InterceptorsNamespaces.Contains('KetPsi.EntityFrameworkCore.Generated'))">$(InterceptorsNamespaces);KetPsi.EntityFrameworkCore.Generated</InterceptorsNamespaces>
  </PropertyGroup>
</Project>
