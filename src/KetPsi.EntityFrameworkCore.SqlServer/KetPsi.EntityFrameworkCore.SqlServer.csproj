<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\version.props" />

  <PropertyGroup>
    <TargetFrameworks>$(KetPsiTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>SQL Server for KetPsi.EntityFrameworkCore: EF Core LINQ queries translated at build time and run on SQL Server under Native AOT. The one package an application installs; it brings KetPsi.EntityFrameworkCore and the EF Core SQL Server provider. Values are typed SqlParameters, and Contains lists and collection loads use one JSON parameter with OPENJSON.</Description>
    <PackageTags>entityframeworkcore;efcore;ef;sqlserver;mssql;nativeaot;aot;source-generator;interceptors;linq;ketpsi</PackageTags>
  </PropertyGroup>

  <!-- Packing turns this into a dependency on the KetPsi.EntityFrameworkCore package of the same version. All of its
       assets must flow, or apps that install only this package would not get the generator (analyzers) and the
       props that enable its interceptors (build). -->
  <ItemGroup>
    <ProjectReference Include="..\KetPsi.EntityFrameworkCore\KetPsi.EntityFrameworkCore.csproj" PrivateAssets="none" />
  </ItemGroup>

  <!-- The EF Core provider this dialect serves, so installing this one package also gives the app UseSqlServer. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KetPsi.EntityFrameworkCore.SqlServer.Tests" />
  </ItemGroup>

</Project>
